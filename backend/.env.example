# Copy this file to ".env" (same folder as this file) and fill in real values.
# Never commit the real ".env" to version control.

# --- App ---
APP_NAME=PaySim Fraud Prevention API
APP_VERSION=4.0.0
ENV=development

# --- Database ---
# Local/dev (SQLite, zero setup):
DATABASE_URL=sqlite:///./paysim_backend.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg2://paysim_user:CHANGE_ME@localhost:5432/paysim_db

# --- JWT ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_super_secret_key_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Project root: point this at wherever the Google Drive target folder tree
# (ID 1ZKZfZRv2xWU9lK9zYYsao16dQRKRCG9f) is actually mounted/synced on THIS
# machine -- e.g. a Colab `drive.mount('/content/drive')` gives
# "/content/drive/MyDrive/Remote_Root_Folder", an rclone/gdown sync gives
# whatever local path you synced it to. Every artifact path below (artifacts/
# phase1, artifacts/phase2, artifacts/phase3/models, ...) is resolved relative
# to this ONE setting -- nothing else needs to change, and no file under it is
# ever renamed or moved.
PROJECT_ROOT=.

# --- Risk routing thresholds (0-100 scale) ---
LOW_RISK_MAX=30
MODERATE_RISK_MAX=60
HIGH_RISK_MAX=80

# --- Resend (real OTP email delivery, primary path — get a key at
# https://resend.com/api-keys). Leave blank to fall back to SMTP below, or to
# just log OTPs to the server console if neither is configured. ---
RESEND_API_KEY=
# Resend's shared sandbox sender only delivers to the account owner's own
# verified email. Once you've verified a domain in Resend, switch this to an
# address on that domain (e.g. otp@yourdomain.com) to email real customers.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- SMTP (fallback OTP email delivery, only used if RESEND_API_KEY is blank) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@paysim-fraud.local

# --- OTP (Safe Vault step-up verification) ---
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# --- Hugging Face token (used both for pulling frozen model artifacts and,
# now, for the free AI-powered XAI narrative feature on the XAI Explorer page.
# Get one at https://huggingface.co/settings/tokens -- the free tier is enough
# for both uses). Read directly via os.getenv, not a pydantic Settings field,
# matching how ml_service.py / graph_service.py already read it.
HF_TOKEN=
# Any chat-capable model actually listed under your account's enabled
# providers at huggingface.co/settings/inference-providers/overview -> Settings
# tab. Enabling "HF Inference" there (free, no external signup) is required
# before ANY model works -- "not supported by any provider you have enabled"
# is the error otherwise, regardless of which model is configured here. The
# code also tries a short built-in fallback list (see xai_narrative_service.py)
# if this exact model ever stops being served.
XAI_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# --- CORS (comma-separated in real deployments behind a proxy that splits this) ---
CORS_ORIGINS=["*"]
